---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import IndexLayout from "../../layouts/IndexLayout.astro";
---

<IndexLayout title="Remindra" lang="es">
	<main>
		<h1>
			<span class="text-gradient">Remindra</span>
		</h1>
		<p class="instructions">
			<span class="text-gradient">Remindra</span> te ayuda a recordar cumpleaños y
			enviarte recordatorios cuando se acerquen.
		</p>
		<ul role="list" class="link-card-grid">
			<Card
				href="https://remindra-bc8e5.web.app/app/"
				title="Abrir la aplicación instalada o web"
				body="Usa la aplicación en la web, sin necesidad de descargarla."
			/>
			<Card
				href="https://play.google.com/store/apps/details?id=com.remindra.birthdayreminder"
				title="Ver en Play Store"
				body="Obtén la aplicación en tu teléfono o tableta Android."
			/>
			<Card
				href="./privacy-policy"
				title="Política de privacidad"
				body="Lee nuestra política de privacidad para conocer cómo manejamos tus datos."
			/>
			<Card
				href="./terms-of-use"
				title="Términos de uso"
				body="Lee nuestros términos de uso para saber cómo puedes usar la aplicación."
			/>
		</ul>
		<p class="instructions">
			Este es un proyecto de código abierto. Puedes ver el código fuente
			en <a href="https://github.com/M26chris/birthday_reminder"
				>https://github.com/M26chris/birthday_reminder</a
			>
		</p>
		<p class="instructions">
			Si necesitas ayuda, contáctame en <a
				href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=support.remindra@gmail.com" target="_blank" rel="noopener noreferrer">support.remindra@gmail.com</a
			>
		</p>
	</main>
</IndexLayout>
