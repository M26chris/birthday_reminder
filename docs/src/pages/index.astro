---
import Card from "../components/Card.astro";
import IndexLayout from "../layouts/IndexLayout.astro";
---

<IndexLayout title="Remindra" lang="en">
	<main>
		<h1>Welcome to <span class="text-gradient">Remindra</span></h1>
		<p class="instructions">
			<span class="text-gradient">Remindra</span> helps you remember birthdays and
			notifies you when they are coming up.
		</p>
		<ul role="list" class="link-card-grid">
			<Card
				href="https://remindra-bc8e5.web.app/app/"
				title="Open App"
				body="Use the installed app or on the web, no download required."
			/>
			<Card
				href="https://play.google.com/store/apps/details?id=com.remindra.birthdayreminder"
				title="View on Play Store"
				body="Get the app on your Android phone or tablet."
			/>
			<Card
				href="/privacy-policy"
				title="Privacy Policy"
				body="Read our privacy policy to learn how we handle your data."
			/>
			<Card
				href="/terms-of-use"
				title="Terms of Use"
				body="Read our terms of use to learn how you can use the app."
			/>
		</ul>
		<p class="instructions">
			This is a open source project. You can view the source code on <a
				href="https://github.com/M26chris/birthday_reminder"
				>https://github.com/M26chris/birthday_reminder</a
			>
		</p>
		<p class="instructions">
			If you need help contact me at <a href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=support.remindra@gmail.com" target="_blank" rel="noopener noreferrer"
				>support.remindra@gmail.com</a
			>
		</p>
		<p class="instructions">
			If you need to delete yout account see <a href="delete-my-data">delete my data</a>
		</p>
	</main>
</IndexLayout>
